# The variables of the local real model route (docs/operations/local-real-model-route.md).
# Copy this file to .env in the main checkout and set mode 600. Never commit .env.
STORYOS_MODEL_DESTINATION=volcengine_agent_plan
STORYOS_MODEL_CREDENTIAL_REFERENCE=env:STORYOS_AGENT_PLAN_API_KEY
STORYOS_AGENT_PLAN_API_KEY=<your Agent Plan API key>
# Only for the runtime qualification of ADR 0049.
STORYOS_MODEL_QUALIFICATION_AUTHORIZATION=<link to the author authorization>
STORYOS_DATABASE_URL=<runtime role PostgreSQL URL>
