# The product variables of the Server and the Worker (ADR 0050). Copy this file to .env in the
# main checkout, set mode 600, and replace each placeholder that the deployment needs.
# Git ignores .env. Never commit it, and never export the key in a shell profile.
# Only the Worker reads this file, in a run with STORYOS_MODEL_DESTINATION=volcengine_agent_plan
# in its process environment or with STORYOS_ENV_FILE=<path>. The Server reads its settings
# from its process environment only.

# Server and Worker
STORYOS_LOG=<off, error, warn, info, or debug>
STORYOS_DATABASE_URL=<runtime role PostgreSQL URL>
STORYOS_EXPORT_LEASE_TTL_SECS=<seconds>

# Server
STORYOS_PUBLIC_ORIGIN=<https origin, unset for the local HTTP profile>
STORYOS_BOOTSTRAP_SESSIONS=<JSON object of session handles and User UUIDs>
STORYOS_CHALLENGE_SECRET=<at least 32 bytes>
STORYOS_MODEL_DESTINATION=<host_fake or volcengine_agent_plan>
STORYOS_MODEL_QUALIFICATION_AUTHORIZATION=<https link to the author authorization, qualification only>
STORYOS_WORKER=<0 to turn off the in-process Worker>

# Worker
STORYOS_AGENT_PLAN_API_KEY=<your Agent Plan API key>

# storyos-storage
STORYOS_STORAGE_ADMIN_URL=<admin PostgreSQL URL for storage activation>
