{
  "version": 1,
  "rules": [
    {"pattern": "crates/*/src/*_tests.rs", "kind": "rust-test", "group": "cargo"},
    {"pattern": "crates/*/tests/*.rs", "kind": "rust-test", "group": "cargo"},
    {"pattern": "apps/web/test/node-contract/*.test.ts", "kind": "web-test", "group": "node-contract"},
    {"pattern": "apps/web/test/node-postgresql/*.test.ts", "kind": "web-test", "group": "node-postgresql"},
    {"pattern": "apps/web/test/node-process-cut/*.test.ts", "kind": "web-test", "group": "node-process-cut"},
    {"pattern": "apps/web/test/browser-source/*.test.ts", "kind": "web-test", "group": "browser-source"},
    {"pattern": "apps/web/test/browser-exact-dist/*.test.ts", "kind": "web-test", "group": "browser-exact-dist"},
    {"pattern": "scripts/*_tests.py", "kind": "verification-test", "group": "verification-tools"},
    {"pattern": "crates/*/migrations/*", "kind": "migration", "group": "complete"},
    {"pattern": "crates/*/fixtures/*", "kind": "fixture", "group": "complete"},
    {"pattern": "crates/*/src/*", "kind": "rust-source", "group": "cargo"},
    {"pattern": "crates/*/benches/*", "kind": "benchmark", "group": "cargo"},
    {"pattern": "crates/*/*", "kind": "crate-configuration", "group": "complete"},
    {"pattern": "apps/web/test/support/*", "kind": "fixture", "group": "complete"},
    {"pattern": "apps/web/*", "kind": "web-source", "group": "complete"},
    {"pattern": "generated/*", "kind": "generated-contract", "group": "contracts"},
    {"pattern": "docs/research/author-edit-batch-browser-process.test.mjs", "kind": "historical-test", "group": "contracts"},
    {"pattern": "docs/*", "kind": "documentation-input", "group": "contracts"},
    {"pattern": "scripts/*", "kind": "verification", "group": "verification-tools"},
    {"pattern": "prototypes/tiptap-proposal-lab/src/*.test.js", "kind": "prototype-test", "group": "complete"},
    {"pattern": "prototypes/*", "kind": "prototype", "group": "complete"},
    {"pattern": ".agents/*", "kind": "agent-guidance", "group": "complete"},
    {"pattern": ".cursor/*", "kind": "agent-guidance", "group": "complete"},
    {"pattern": ".githooks/*", "kind": "git-policy", "group": "complete"},
    {"pattern": ".github/*", "kind": "ci-policy", "group": "complete"},
    {"pattern": "*.md", "kind": "documentation-input", "group": "contracts"},
    {"pattern": "Cargo.toml", "kind": "configuration", "group": "complete"},
    {"pattern": "Cargo.lock", "kind": "configuration", "group": "complete"},
    {"pattern": "rustfmt.toml", "kind": "configuration", "group": "complete"},
    {"pattern": "package.json", "kind": "configuration", "group": "complete"},
    {"pattern": "pnpm-*.yaml", "kind": "configuration", "group": "complete"},
    {"pattern": "Makefile", "kind": "verification", "group": "complete"},
    {"pattern": ".gitignore", "kind": "configuration", "group": "complete"}
  ]
}
