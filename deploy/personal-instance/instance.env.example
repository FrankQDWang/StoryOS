# The parameters of the personal instance (ADR 0104). install.sh copies this file to /etc/storyos/instance.env with
# mode 600. Set each value there. No value is a secret: secrets.sh writes the secrets to their own files.

# The DNS name of the instance, in lower case, with no scheme and no port.
STORYOS_HOST=
# The user name of the HTTP Basic authentication of Caddy.
STORYOS_PROXY_USER=author
# The host and the port of the session pooler of the database project, and the database name.
STORYOS_DATABASE_HOST=
STORYOS_DATABASE_PORT=5432
STORYOS_DATABASE_NAME=postgres
# The user names of the pooler: the admin login and the runtime role, each with the suffix .<project reference>.
STORYOS_DATABASE_ADMIN_USER=
STORYOS_DATABASE_RUNTIME_USER=
# require for the hosted database. none only for a test database on the loopback address.
STORYOS_DATABASE_TLS=require
