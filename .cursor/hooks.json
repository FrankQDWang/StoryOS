{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/on-session-start.py",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/on-stop.py",
        "timeout": 15,
        "loop_limit": 20
      }
    ]
  }
}
