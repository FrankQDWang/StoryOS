{
  "version": 1,
  "targeted": {
    "verification-observation-tests": {"command": ["python3", "-m", "unittest", "discover", "-s", "scripts", "-p", "verification_observation_tests.py"], "clean": false},
    "verify-policy": {"command": ["make", "verify-policy"], "clean": false},
    "contracts": {"command": ["make", "contracts"], "clean": true},
    "web-typecheck": {"command": ["make", "web-typecheck"], "clean": false},
    "release-package": {"command": ["make", "release-package"], "clean": true},
    "web-foundation": {"command": ["make", "web-foundation"], "clean": true},
    "web": {"command": ["make", "web"], "clean": true},
    "project-scope": {"command": ["make", "project-scope"], "clean": true},
    "verify-tracker": {"command": ["make", "verify-tracker"], "clean": false},
    "verify-pr": {"command": ["make", "verify-pr"], "clean": false},
    "verify-contract-inputs": {"command": ["make", "verify-contract-inputs"], "clean": false},
    "verification-tests": {"command": ["python3", "-m", "unittest", "discover", "-s", "scripts", "-p", "*_tests.py"], "clean": false},
    "rust-tests": {"command": ["python3", "scripts/verification.py", "rust-tests"], "clean": false}
  },
  "complete": {
    "admission": {"version": 1, "targeted": ["verify-policy"]},
    "recovery": {"project-scope": ["make", "project-scope"]},
    "stages": [
      "input-ownership", "project-inputs", "verification-tests",
      "rust-format", "rust-clippy", "rust-tests",
      "rust-doc-tests", "protocol-self-test", "persistence-self-test",
      "author-edit-self-test", "tracker-self-test", "transaction-self-test",
      "generated-contracts", "node-install", "web-typecheck",
      "release-package", "web-build", "rust-release-build",
      "foundation-tests", "project-scope", "postgres-scope",
      "postgres-challenge", "postgres-library", "http-files",
      "author-edit-process-cut", "readable-export-process-cut", "project-export-process-cut",
      "exact-dist", "recovery-fixture", "recovery-mixed",
      "workspace-boundaries", "author-edit-policy", "transaction-guards"
    ],
    "groups": {
      "cargo": ["rust-tests"],
      "verification-tools": ["verification-tests"],
      "node-contract": ["foundation-tests"],
      "browser-source": ["foundation-tests"],
      "node-postgresql": ["http-files"],
      "node-process-cut": ["author-edit-process-cut", "readable-export-process-cut", "project-export-process-cut"],
      "browser-exact-dist": ["exact-dist"]
    }
  },
  "shared_phases": [
    {
      "name": "http-bootstrap",
      "group": "node-postgresql",
      "stage": "http-files",
      "prepare": "none"
    },
    {
      "name": "author-edit-process-cut",
      "group": "node-process-cut",
      "stage": "author-edit-process-cut",
      "prepare": "reset-challenge"
    },
    {
      "name": "http-main",
      "group": "node-postgresql",
      "stage": "http-files",
      "prepare": "reset-challenge"
    },
    {
      "name": "readable-export-process-cut",
      "group": "node-process-cut",
      "stage": "readable-export-process-cut",
      "prepare": "reload-fixture"
    },
    {
      "name": "project-export-process-cut",
      "group": "node-process-cut",
      "stage": "project-export-process-cut",
      "prepare": "reload-fixture"
    }
  ],
  "daily_consumers": [
    {"pattern": "crates/storyos-application/*", "groups": ["database", "node-postgresql"]},
    {"pattern": "crates/storyos-server/*", "groups": ["database", "node-postgresql", "node-contract"]},
    {"pattern": "crates/storyos-worker/*", "groups": ["database", "node-process-cut"]},
    {"pattern": "crates/storyos-adapter-postgres/*", "groups": ["database", "node-postgresql", "node-process-cut"]},
    {"pattern": "crates/storyos-contracts/*", "groups": ["contracts", "node-contract", "browser-source", "node-postgresql"]},
    {"pattern": "crates/*/migrations/*", "groups": ["database", "node-postgresql"]},
    {"pattern": "crates/*/fixtures/*", "groups": ["database", "node-postgresql"]},
    {"pattern": "generated/*", "groups": ["contracts", "node-contract", "browser-source", "node-postgresql"]},
    {"pattern": "docs/*", "groups": ["contracts"]},
    {"pattern": "docs/agents/verification*", "groups": ["policy"]},
    {"pattern": "*.md", "groups": ["contracts"]},
    {"pattern": "apps/web/src/*", "groups": ["node-contract", "browser-source"]},
    {"pattern": "apps/web/test/support/*", "groups": ["node-contract", "browser-source", "node-postgresql", "node-process-cut"]},
    {"pattern": "apps/web/test/node-postgresql/*", "groups": ["node-postgresql"]},
    {"pattern": "apps/web/test/browser-source/*", "groups": ["browser-source"]},
    {"pattern": "apps/web/*.json", "groups": ["web-typecheck", "node-contract", "browser-source", "node-postgresql", "node-process-cut"]},
    {"pattern": "apps/web/*config.ts", "groups": ["web-typecheck", "node-contract", "browser-source", "node-postgresql", "node-process-cut"]},
    {"pattern": "package.json", "groups": ["web-typecheck", "node-contract", "browser-source", "node-postgresql", "node-process-cut"]},
    {"pattern": "pnpm-*.yaml", "groups": ["web-typecheck", "node-contract", "browser-source", "node-postgresql", "node-process-cut"]},
    {"pattern": "scripts/*", "groups": ["policy"]},
    {"pattern": "scripts/package-release.py", "groups": ["node-contract", "browser-source", "database", "node-postgresql", "node-process-cut", "exact-dist", "recovery"]},
    {"pattern": "scripts/verify-project-scope.sh", "groups": ["database", "node-postgresql", "node-process-cut", "exact-dist", "recovery", "pending"]},
    {"pattern": "scripts/verification_shared.py", "groups": ["node-postgresql", "node-process-cut"]},
    {"pattern": "scripts/lib/*postgres*", "groups": ["database", "node-postgresql", "node-process-cut"]},
    {"pattern": "scripts/verify-daily-database.sh", "groups": ["database", "node-postgresql", "node-process-cut"]},
    {"pattern": "scripts/verify-recovery*", "groups": ["recovery"]},
    {"pattern": "Makefile", "groups": ["policy", "pending"]}
  ],
  "daily_workers": 2,
  "result_cache_profiles": ["node-contract"],
  "file_profiles": {
    "node-contract": "// Verification: repository-inputs-only.",
    "cargo": "// Verification: repository-inputs-only."
  },
  "rules": [
    {"pattern": "crates/*/src/*_tests.rs", "kind": "rust-test", "group": "cargo"},
    {"pattern": "crates/*/tests/*.rs", "kind": "rust-test", "group": "cargo"},
    {"pattern": "apps/web/test/node-contract/*.test.ts", "kind": "web-test", "group": "node-contract"},
    {"pattern": "apps/web/test/node-postgresql/*.test.ts", "kind": "web-test", "group": "node-postgresql"},
    {"pattern": "apps/web/test/node-process-cut/*.test.ts", "kind": "web-test", "group": "node-process-cut"},
    {"pattern": "apps/web/test/browser-source/*.test.ts", "kind": "web-test", "group": "browser-source"},
    {"pattern": "apps/web/test/browser-exact-dist/*.test.ts", "kind": "web-test", "group": "browser-exact-dist"},
    {"pattern": "apps/web/test/browser-exact-dist/stage1-journey-expectation.ts", "kind": "fixture", "group": "complete"},
    {"pattern": "apps/web/test/browser-source/journal-version-three.ts", "kind": "fixture", "group": "complete"},
    {"pattern": "apps/web/test/browser-source/local-edit-journal-append-fixture.ts", "kind": "fixture", "group": "complete"},
    {"pattern": "apps/web/test/browser-source/scenario.ts", "kind": "fixture", "group": "complete"},
    {"pattern": "apps/web/test/node-postgresql/export-acknowledgement-support.ts", "kind": "fixture", "group": "complete"},
    {"pattern": "scripts/*_tests.py", "kind": "verification-test", "group": "verification-tools"},
    {"pattern": "crates/*/migrations/*", "kind": "migration", "group": "complete"},
    {"pattern": "crates/*/fixtures/*", "kind": "fixture", "group": "complete"},
    {"pattern": "crates/*/src/*", "kind": "rust-source", "group": "cargo"},
    {"pattern": "crates/*/benches/*", "kind": "benchmark", "group": "cargo"},
    {"pattern": "crates/*/*", "kind": "crate-configuration", "group": "complete"},
    {"pattern": "apps/web/test/support/*", "kind": "fixture", "group": "complete"},
    {"pattern": "apps/web/*", "kind": "web-source", "group": "complete"},
    {"pattern": "generated/*", "kind": "generated-contract", "group": "contracts"},
    {"pattern": "docs/research/author-edit-batch-browser-process.test.mjs", "kind": "historical-test", "group": "contracts"},
    {"pattern": "docs/*", "kind": "documentation-input", "group": "contracts"},
    {"pattern": "scripts/*", "kind": "verification", "group": "verification-tools"},
    {"pattern": "prototypes/tiptap-proposal-lab/src/*.test.js", "kind": "prototype-test", "group": "complete"},
    {"pattern": "prototypes/*", "kind": "prototype", "group": "complete"},
    {"pattern": ".agents/*", "kind": "agent-guidance", "group": "complete"},
    {"pattern": ".cursor/*", "kind": "agent-guidance", "group": "complete"},
    {"pattern": ".githooks/*", "kind": "git-policy", "group": "complete"},
    {"pattern": ".github/*", "kind": "ci-policy", "group": "complete"},
    {"pattern": "*.md", "kind": "documentation-input", "group": "contracts"},
    {"pattern": "Cargo.toml", "kind": "configuration", "group": "complete"},
    {"pattern": "Cargo.lock", "kind": "configuration", "group": "complete"},
    {"pattern": "rustfmt.toml", "kind": "configuration", "group": "complete"},
    {"pattern": "package.json", "kind": "configuration", "group": "complete"},
    {"pattern": "pnpm-*.yaml", "kind": "configuration", "group": "complete"},
    {"pattern": "Makefile", "kind": "verification", "group": "complete"},
    {"pattern": ".gitignore", "kind": "configuration", "group": "complete"}
  ]
}
