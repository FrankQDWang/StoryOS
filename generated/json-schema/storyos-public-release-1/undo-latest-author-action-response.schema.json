{
  "$defs": {
    "AuthoritativeChapterRevision": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "items": {
            "$ref": "#/$defs/ManuscriptBlock"
          },
          "type": "array"
        },
        "body": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        }
      },
      "required": [
        "revision_id",
        "body",
        "blocks"
      ],
      "type": "object"
    },
    "ControlledProject": {
      "additionalProperties": false,
      "properties": {
        "open": {
          "$ref": "#/$defs/ProjectOpenState"
        },
        "project_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "title",
        "open"
      ],
      "type": "object"
    },
    "DigestAlgorithm": {
      "enum": [
        "sha256"
      ],
      "type": "string"
    },
    "DigestValue": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/DigestAlgorithm"
        },
        "profile": {
          "type": "string"
        },
        "value_hex_lowercase": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "profile",
        "value_hex_lowercase"
      ],
      "type": "object"
    },
    "DomainReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifact_lifecycle_event_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "author_action_sequence": {
          "type": "string"
        },
        "author_command_admission_id": {
          "type": "string"
        },
        "authoritative_commit_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "authoritative_revision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command_digest": {
          "$ref": "#/$defs/DigestValue"
        },
        "command_kind": {
          "$ref": "#/$defs/DomainReceiptCommandKind"
        },
        "condition_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "type": "string"
        },
        "draft_artifact_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "idempotency_key": {
          "type": "string"
        },
        "prior_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "producer_cause": {
          "$ref": "#/$defs/DomainReceiptProducerCause"
        },
        "project_scope": {
          "$ref": "#/$defs/ProjectScope"
        },
        "proposal_revision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "receipt_id": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/DomainReceiptResult"
        },
        "resulting_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "project_scope",
        "command_kind",
        "command_digest",
        "idempotency_key",
        "producer_cause",
        "author_command_admission_id",
        "expected_heads",
        "prior_heads",
        "resulting_heads",
        "authoritative_revision_ids",
        "proposal_revision_ids",
        "authoritative_commit_ids",
        "author_action_sequence",
        "draft_artifact_refs",
        "artifact_lifecycle_event_refs",
        "condition_refs",
        "result",
        "created_at"
      ],
      "type": "object"
    },
    "DomainReceiptCommandKind": {
      "enum": [
        "applyAuthorEdit",
        "takeOverProjectWriter",
        "createProject",
        "updateProject",
        "archiveProject",
        "createVolume",
        "createChapter",
        "updateVolume",
        "updateChapter",
        "deleteChapter",
        "deleteVolume",
        "setCurrentChapter",
        "undoLatestAuthorAction",
        "exportHumanReadableManuscript",
        "exportProjectArchive"
      ],
      "type": "string"
    },
    "DomainReceiptProducerCause": {
      "enum": [
        "author_command_admission"
      ],
      "type": "string"
    },
    "DomainReceiptResult": {
      "enum": [
        "authoritative_applied",
        "no_effect",
        "conflicted",
        "refused"
      ],
      "type": "string"
    },
    "ManuscriptBlock": {
      "additionalProperties": false,
      "properties": {
        "block_kind": {
          "$ref": "#/$defs/ManuscriptBlockKind"
        },
        "manuscript_block_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "manuscript_block_id",
        "block_kind",
        "text"
      ],
      "type": "object"
    },
    "ManuscriptBlockKind": {
      "enum": [
        "paragraph",
        "heading"
      ],
      "type": "string"
    },
    "ProjectOpenState": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "current_chapter_id": {
              "type": "string"
            },
            "kind": {
              "const": "current_chapter",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "current_chapter_id"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    },
    "UndoLatestAuthorActionConflictReason": {
      "enum": [
        "frontier_mismatch",
        "wrong_target_head"
      ],
      "type": "string"
    },
    "UndoLatestAuthorActionEffect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "author_action_sequence": {
              "type": "string"
            },
            "author_undo_frontier_sequence": {
              "type": [
                "string",
                "null"
              ]
            },
            "authoritative_commit_id": {
              "type": "string"
            },
            "authoritative_revision": {
              "$ref": "#/$defs/AuthoritativeChapterRevision"
            },
            "kind": {
              "const": "compensated",
              "type": "string"
            },
            "project_activity_position": {
              "type": "string"
            },
            "source_sequence": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source_sequence",
            "author_action_sequence",
            "authoritative_commit_id",
            "authoritative_revision",
            "project_activity_position"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "current_author_undo_frontier_sequence": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "conflicted",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UndoLatestAuthorActionConflictReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unavailable",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UndoLatestAuthorActionUnavailableReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "UndoLatestAuthorActionUnavailableReason": {
      "enum": [
        "no_frontier",
        "barrier"
      ],
      "type": "string"
    }
  },
  "$id": "storyos.command.undo-latest-author-action.response.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author_command_admission_id": {
      "format": "uuid",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "type": "string"
    },
    "effect": {
      "$ref": "#/$defs/UndoLatestAuthorActionEffect"
    },
    "project": {
      "$ref": "#/$defs/ControlledProject"
    },
    "project_scope": {
      "$ref": "#/$defs/ProjectScope"
    },
    "receipt": {
      "$ref": "#/$defs/DomainReceipt"
    },
    "schema_id": {
      "const": "storyos.command.undo-latest-author-action.response.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "correlation_id",
    "project_scope",
    "command_id",
    "author_command_admission_id",
    "receipt",
    "project",
    "effect"
  ],
  "title": "StoryOS Undo Latest Author Action Response",
  "type": "object"
}
