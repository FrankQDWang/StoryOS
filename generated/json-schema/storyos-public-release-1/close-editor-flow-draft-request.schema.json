      "type": "object"
    }
  },
  "$id": "storyos.command.close-editor-flow-draft.request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "close_editor_flow_draft_input": {
      "$ref": "#/$defs/CloseEditorFlowDraftInput"
    },
    "command_schema": {
      "const": "storyos.command.close-editor-flow-draft.request.v1",
      "type": "string"
    }
  },
  "required": [
    "command_schema",
    "close_editor_flow_draft_input"
  ],
  "title": "StoryOS Reject Proposal Operations Request",
  "type": "object"
}
