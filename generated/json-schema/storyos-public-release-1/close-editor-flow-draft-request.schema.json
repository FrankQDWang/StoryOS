          "const": "abandoned",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "type": "string"
        },
        "draft_kind": {
          "const": "refused_edit",
          "type": "string"
        },
        "editor_session_id": {
          "format": "uuid",
          "type": "string"
        },
        "expected_closure": {
          "const": "open",
          "type": "string"
        },
        "security_policy_revision": {
          "type": "string"
        },
        "source_current_draft_revision_id": {
          "format": "uuid",
          "type": "string"
        },
        "source_draft_payload_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "draft_kind",
        "source_current_draft_revision_id",
        "source_draft_payload_digest",
        "expected_closure",
