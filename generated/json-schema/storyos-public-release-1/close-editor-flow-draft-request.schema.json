{
  "$defs": {
    "CloseEditorFlowDraftInput": {
      "additionalProperties": false,
      "properties": {
        "client_contract_revision": {
          "type": "string"
        },
        "close_reason": {
          "const": "abandoned",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "type": "string"
        },
        "draft_id": {
          "format": "uuid",
          "type": "string"
        },
        "draft_kind": {
          "const": "refused_edit",
          "type": "string"
        },
        "editor_session_id": {
          "format": "uuid",
          "type": "string"
        },
        "expected_closure": {
          "const": "open",
          "type": "string"
        },
        "security_policy_revision": {
          "type": "string"
        },
        "source_current_draft_revision_id": {
          "format": "uuid",
          "type": "string"
        },
        "source_draft_payload_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "writer_generation": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "draft_kind",
        "source_current_draft_revision_id",
        "source_draft_payload_digest",
        "expected_closure",
        "close_reason",
        "editor_session_id",
        "writer_generation",
        "client_contract_revision",
        "security_policy_revision",
        "correlation_id"
      ],
      "type": "object"
    }
  },
  "$id": "storyos.command.close-editor-flow-draft.request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "close_editor_flow_draft_input": {
      "$ref": "#/$defs/CloseEditorFlowDraftInput"
    },
    "command_schema": {
      "const": "storyos.command.close-editor-flow-draft.request.v1",
      "type": "string"
    }
  },
  "required": [
    "command_schema",
    "close_editor_flow_draft_input"
  ],
  "title": "StoryOS Close Editor Flow Draft Request",
  "type": "object"
}
