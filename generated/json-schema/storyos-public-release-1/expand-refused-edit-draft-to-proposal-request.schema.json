{
  "$defs": {
    "ExpandRefusedEditDraftInput": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "items": {
            "$ref": "#/$defs/ProposalAnchorInspect"
          },
          "type": "array"
        },
        "chapter_id": {
          "type": "string"
        },
        "client_contract_revision": {
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "type": "string"
        },
        "draft_id": {
          "format": "uuid",
          "type": "string"
        },
        "editor_session_id": {
          "format": "uuid",
          "type": "string"
        },
        "expected_source_draft_closure": {
          "const": "open",
          "type": "string"
        },
        "expected_target_revisions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "proposal_kind": {
          "const": "inline_edit",
          "type": "string"
        },
        "security_policy_revision": {
          "type": "string"
        },
        "selected_payload_range": {
          "$ref": "#/$defs/WholeDraftPayload"
        },
        "source_current_draft_revision_id": {
          "format": "uuid",
          "type": "string"
        },
        "source_draft_payload_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_reopen_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "writer_generation": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "source_current_draft_revision_id",
        "source_draft_payload_digest",
        "expected_source_draft_closure",
        "selected_payload_range",
        "proposal_kind",
        "chapter_id",
        "target_refs",
        "expected_target_revisions",
        "anchors",
        "editor_session_id",
        "writer_generation",
        "client_contract_revision",
        "security_policy_revision",
        "correlation_id"
      ],
      "type": "object"
    },
    "ProposalAnchorInspect": {
      "additionalProperties": false,
      "properties": {
        "base_authoritative_revision_id": {
          "type": "string"
        },
        "base_slice_digest": {
          "type": "string"
        },
        "boundary_profile": {
          "type": "string"
        },
        "coordinate_profile": {
          "type": "string"
        },
        "from": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "manuscript_block_id": {
          "type": "string"
        },
        "manuscript_schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "manuscript_block_id",
        "base_authoritative_revision_id",
        "manuscript_schema_version",
        "coordinate_profile",
        "from",
        "to",
        "boundary_profile",
        "base_slice_digest"
      ],
      "type": "object"
    },
    "WholeDraftPayload": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "whole_draft_payload",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "storyos.command.expand-refused-edit-draft-to-proposal.request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command_schema": {
      "const": "storyos.command.expand-refused-edit-draft-to-proposal.request.v1",
      "type": "string"
    },
    "expand_refused_edit_draft_to_proposal_input": {
      "$ref": "#/$defs/ExpandRefusedEditDraftInput"
    }
  },
  "required": [
    "command_schema",
    "expand_refused_edit_draft_to_proposal_input"
  ],
  "title": "StoryOS Close Editor Flow Draft Request",
  "type": "object"
}
