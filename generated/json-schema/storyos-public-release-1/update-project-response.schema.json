{
  "$defs": {
    "ControlledProject": {
      "additionalProperties": false,
      "properties": {
        "open": {
          "$ref": "#/$defs/ProjectOpenState"
        },
        "project_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "title",
        "open"
      ],
      "type": "object"
    },
    "DigestAlgorithm": {
      "enum": [
        "sha256"
      ],
      "type": "string"
    },
    "DigestValue": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/DigestAlgorithm"
        },
        "profile": {
          "type": "string"
        },
        "value_hex_lowercase": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "profile",
        "value_hex_lowercase"
      ],
      "type": "object"
    },
    "DomainReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifact_lifecycle_event_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "author_action_sequence": {
          "type": "string"
        },
        "author_command_admission_id": {
          "type": "string"
        },
        "authoritative_commit_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "authoritative_revision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command_digest": {
          "$ref": "#/$defs/DigestValue"
        },
        "command_kind": {
          "$ref": "#/$defs/DomainReceiptCommandKind"
        },
        "condition_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "type": "string"
        },
        "draft_artifact_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "idempotency_key": {
          "type": "string"
        },
        "prior_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "producer_cause": {
          "$ref": "#/$defs/DomainReceiptProducerCause"
        },
        "project_scope": {
          "$ref": "#/$defs/ProjectScope"
        },
        "proposal_revision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "receipt_id": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/DomainReceiptResult"
        },
        "resulting_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "project_scope",
        "command_kind",
        "command_digest",
        "idempotency_key",
        "producer_cause",
        "author_command_admission_id",
        "expected_heads",
        "prior_heads",
        "resulting_heads",
        "authoritative_revision_ids",
        "proposal_revision_ids",
        "authoritative_commit_ids",
        "author_action_sequence",
        "draft_artifact_refs",
        "artifact_lifecycle_event_refs",
        "condition_refs",
        "result",
        "created_at"
      ],
      "type": "object"
    },
    "DomainReceiptCommandKind": {
      "enum": [
        "applyAuthorEdit",
        "takeOverProjectWriter",
        "createProject",
        "updateProject",
        "archiveProject",
        "createVolume"
      ],
      "type": "string"
    },
    "DomainReceiptProducerCause": {
      "enum": [
        "author_command_admission"
      ],
      "type": "string"
    },
    "DomainReceiptResult": {
      "enum": [
        "authoritative_applied",
        "no_effect",
        "conflicted",
        "refused"
      ],
      "type": "string"
    },
    "ProjectOpenState": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "current_chapter_id": {
              "type": "string"
            },
            "kind": {
              "const": "current_chapter",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "current_chapter_id"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    },
    "UpdateProjectConflictReason": {
      "enum": [
        "stale_project_revision"
      ],
      "type": "string"
    },
    "UpdateProjectEffect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "authoritative_applied",
              "type": "string"
            },
            "project_activity_position": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "title",
            "revision",
            "project_activity_position"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "no_effect",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UpdateProjectNoEffectReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "conflicted",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UpdateProjectConflictReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "UpdateProjectNoEffectReason": {
      "enum": [
        "title_unchanged"
      ],
      "type": "string"
    }
  },
  "$id": "storyos.command.update-project.response.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author_command_admission_id": {
      "format": "uuid",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "type": "string"
    },
    "effect": {
      "$ref": "#/$defs/UpdateProjectEffect"
    },
    "project": {
      "$ref": "#/$defs/ControlledProject"
    },
    "project_scope": {
      "$ref": "#/$defs/ProjectScope"
    },
    "receipt": {
      "$ref": "#/$defs/DomainReceipt"
    },
    "schema_id": {
      "const": "storyos.command.update-project.response.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "correlation_id",
    "project_scope",
    "command_id",
    "author_command_admission_id",
    "receipt",
    "project",
    "effect"
  ],
  "title": "StoryOS Update Project Response",
  "type": "object"
}
