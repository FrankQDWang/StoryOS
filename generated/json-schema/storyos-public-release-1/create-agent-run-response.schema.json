{
  "$defs": {
    "AgentRunRef": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "agent_run",
              "type": "string"
            },
            "run_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "run_id"
          ],
          "type": "object"
        }
      ]
    },
    "ControlledProject": {
      "additionalProperties": false,
      "properties": {
        "open": {
          "$ref": "#/$defs/ProjectOpenState"
        },
        "project_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "title",
        "open"
      ],
      "type": "object"
    },
    "CreateAgentRunEffect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "conversation_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "admitted",
              "type": "string"
            },
            "memory_settings_revision": {
              "format": "uuid",
              "type": "string"
            },
            "project_activity_position": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            },
            "project_agent_id": {
              "format": "uuid",
              "type": "string"
            },
            "run_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "project_agent_id",
            "conversation_id",
            "memory_settings_revision",
            "run_id",
            "project_activity_position"
          ],
          "type": "object"
        }
      ]
    },
    "ExportAcknowledgement": {
      "enum": [
        "accepted"
      ],
      "type": "string"
    },
    "ProjectOpenState": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "current_chapter_id": {
              "type": "string"
            },
            "kind": {
              "const": "current_chapter",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "current_chapter_id"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    }
  },
  "$id": "storyos.command.create-agent-run.response.v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acknowledgement": {
      "$ref": "#/$defs/ExportAcknowledgement"
    },
    "author_command_admission_id": {
      "format": "uuid",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "type": "string"
    },
    "conversation_id": {
      "format": "uuid",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "type": "string"
    },
    "effect": {
      "$ref": "#/$defs/CreateAgentRunEffect"
    },
    "memory_settings_revision": {
      "format": "uuid",
      "type": "string"
    },
    "operation_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentRunRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "project": {
      "$ref": "#/$defs/ControlledProject"
    },
    "project_agent_id": {
      "format": "uuid",
      "type": "string"
    },
    "project_scope": {
      "$ref": "#/$defs/ProjectScope"
    },
    "schema_id": {
      "const": "storyos.command.create-agent-run.response.v2",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "correlation_id",
    "project_scope",
    "command_id",
    "author_command_admission_id",
    "acknowledgement",
    "project",
    "project_agent_id",
    "conversation_id",
    "memory_settings_revision",
    "effect"
  ],
  "title": "StoryOS Create Agent Run Response",
  "type": "object"
}
