{
  "$defs": {
    "ControlledProject": {
      "additionalProperties": false,
      "properties": {
        "open": {
          "$ref": "#/$defs/ProjectOpenState"
        },
        "project_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "title",
        "open"
      ],
      "type": "object"
    },
    "ProjectOpenState": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "current_chapter_id": {
              "type": "string"
            },
            "kind": {
              "const": "current_chapter",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "current_chapter_id"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    }
  },
  "$id": "storyos.query.project.response.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/ControlledProject"
    },
    "project_scope": {
      "$ref": "#/$defs/ProjectScope"
    },
    "schema_id": {
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "correlation_id",
    "project_scope",
    "project"
  ],
  "title": "StoryOS Project Query Response",
  "type": "object"
}
