{
  "$defs": {
    "MemoryEntryFlagInspect": {
      "additionalProperties": false,
      "description": "The conflict flag of the current version of an entry (ADR 0094 section 7): the reason, the\nsource of the conflict, and the time of the flag version.",
      "properties": {
        "flagged_at": {
          "format": "date-time",
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/MemoryEntrySourceInspect"
        }
      },
      "required": [
        "reason",
        "source",
        "flagged_at"
      ],
      "type": "object"
    },
    "MemoryEntryInspect": {
      "additionalProperties": false,
      "description": "The current version of one Memory Entry. The `source` is `null` when the version has no source\nreference that the Host can decode. Only an entry with a conflict flag has `flag`. Only a\ncharacter entry of the background work with a current intent result has `intent`.",
      "properties": {
        "changed_at": {
          "format": "date-time",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "entry_number": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        },
        "entry_type": {
          "$ref": "#/$defs/MemoryEntryTypeInspect"
        },
        "flag": {
          "$ref": "#/$defs/MemoryEntryFlagInspect"
        },
        "intent": {
          "$ref": "#/$defs/MemoryEntryIntentInspect"
        },
        "memory_entry_id": {
          "format": "uuid",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/MemoryEntryOriginInspect"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryEntrySourceInspect"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        }
      },
      "required": [
        "memory_entry_id",
        "entry_number",
        "version",
        "entry_type",
        "title",
        "description",
        "text",
        "origin",
        "source",
        "changed_at"
      ],
      "type": "object"
    },
    "MemoryEntryIntentInspect": {
      "additionalProperties": false,
      "description": "The current result of the intent pass of a character entry of the background work (ADR 0101\nsections 4 and 6): the intent, at most three questions to the author, the Chapter at which the\npass made the result, and the time of the result. The `chapter` is `null` when the pass had no\nChapter.",
      "properties": {
        "chapter": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemoryIntentChapterInspect"
            },
            {
              "type": "null"
            }
          ]
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "recorded_at": {
          "format": "date-time",
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "questions",
        "chapter",
        "recorded_at"
      ],
      "type": "object"
    },
    "MemoryEntryOriginInspect": {
      "description": "What made the current version of an entry.",
      "enum": [
        "author_request",
        "conversation",
        "chapter"
      ],
      "type": "string"
    },
    "MemoryEntrySourceInspect": {
      "description": "The first source reference of the current version of an entry. The `title` of a Chapter is\n`null` when the Chapter is unavailable.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "availability": {
              "$ref": "#/$defs/MemorySourceAvailability"
            },
            "conversation_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "conversation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "conversation_id",
            "availability"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "availability": {
              "$ref": "#/$defs/MemorySourceAvailability"
            },
            "chapter_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "chapter",
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "chapter_id",
            "availability"
          ],
          "type": "object"
        }
      ]
    },
    "MemoryEntryTypeInspect": {
      "description": "The type of a Memory Entry (ADR 0094 section 3), in the order of the Memory Index.",
      "enum": [
        "writing_preference",
        "foreshadowing",
        "character",
        "relationship",
        "major_event",
        "other"
      ],
      "type": "string"
    },
    "MemoryIntentChapterInspect": {
      "additionalProperties": false,
      "description": "The Chapter at which an intent pass made its result, in the form of the Chapter source of an\nentry: the `title` is `null` when the Chapter is unavailable.",
      "properties": {
        "availability": {
          "$ref": "#/$defs/MemorySourceAvailability"
        },
        "chapter_id": {
          "format": "uuid",
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "chapter_id",
        "title",
        "availability"
      ],
      "type": "object"
    },
    "MemorySourceAvailability": {
      "description": "`available` when the Project has the record of the source now (Memory contract, section 10).",
      "enum": [
        "available",
        "unavailable"
      ],
      "type": "string"
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    }
  },
  "$id": "storyos.query.memory-entries.response.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The current entries of a Project in the order of the Memory Index. The Host limits bound the\nlist, so it has no pages.",
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/MemoryEntryInspect"
      },
      "type": "array"
    },
    "project_scope": {
      "$ref": "#/$defs/ProjectScope"
    },
    "schema_id": {
      "const": "storyos.query.memory-entries.response.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "correlation_id",
    "project_scope",
    "entries"
  ],
  "title": "StoryOS Memory Entries Response",
  "type": "object"
}
