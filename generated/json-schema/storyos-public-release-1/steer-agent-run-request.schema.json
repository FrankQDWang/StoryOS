{
  "$defs": {
    "AuthorMessage": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "SelectionCoordinateProfile": {
      "enum": [
        "storyos.editor.utf16-code-unit.v1"
      ],
      "type": "string"
    },
    "SelectionPoint": {
      "additionalProperties": false,
      "properties": {
        "manuscript_block_id": {
          "format": "uuid",
          "type": "string"
        },
        "offset": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "manuscript_block_id",
        "offset"
      ],
      "type": "object"
    },
    "SelectionReference": {
      "description": "One exact text range that the author added to the message (ADR 0062).",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "base_authoritative_revision_id": {
              "format": "uuid",
              "type": "string"
            },
            "chapter_id": {
              "format": "uuid",
              "type": "string"
            },
            "coordinate_profile": {
              "$ref": "#/$defs/SelectionCoordinateProfile"
            },
            "end": {
              "$ref": "#/$defs/SelectionPoint"
            },
            "kind": {
              "const": "chapter_text",
              "type": "string"
            },
            "start": {
              "$ref": "#/$defs/SelectionPoint"
            }
          },
          "required": [
            "kind",
            "chapter_id",
            "base_authoritative_revision_id",
            "coordinate_profile",
            "start",
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "chapter_id": {
              "format": "uuid",
              "type": "string"
            },
            "coordinate_profile": {
              "$ref": "#/$defs/SelectionCoordinateProfile"
            },
            "end_offset": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "proposal_candidate_text",
              "type": "string"
            },
            "operation_id": {
              "format": "uuid",
              "type": "string"
            },
            "proposal_id": {
              "format": "uuid",
              "type": "string"
            },
            "revision_id": {
              "format": "uuid",
              "type": "string"
            },
            "start_offset": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "chapter_id",
            "proposal_id",
            "operation_id",
            "revision_id",
            "coordinate_profile",
            "start_offset",
            "end_offset"
          ],
          "type": "object"
        }
      ]
    },
    "SteerAgentRunInput": {
      "additionalProperties": false,
      "properties": {
        "author_message": {
          "$ref": "#/$defs/AuthorMessage"
        },
        "client_contract_revision": {
          "type": "string"
        },
        "conversation_id": {
          "format": "uuid",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "type": "string"
        },
        "security_policy_revision": {
          "type": "string"
        },
        "selection_references": {
          "items": {
            "$ref": "#/$defs/SelectionReference"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "conversation_id",
        "author_message",
        "client_contract_revision",
        "security_policy_revision",
        "correlation_id"
      ],
      "type": "object"
    }
  },
  "$id": "storyos.command.steer-agent-run.request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command_schema": {
      "const": "storyos.command.steer-agent-run.request.v1",
      "type": "string"
    },
    "steer_agent_run_input": {
      "$ref": "#/$defs/SteerAgentRunInput"
    }
  },
  "required": [
    "command_schema",
    "steer_agent_run_input"
  ],
  "title": "StoryOS Steering Input Request",
  "type": "object"
}
