{
  "$defs": {
    "DigestAlgorithm": {
      "enum": [
        "sha256"
      ],
      "type": "string"
    },
    "DigestValue": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/DigestAlgorithm"
        },
        "profile": {
          "type": "string"
        },
        "value_hex_lowercase": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "profile",
        "value_hex_lowercase"
      ],
      "type": "object"
    },
    "DomainReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifact_lifecycle_event_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "author_action_sequence": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "author_command_admission_id": {
          "type": "string"
        },
        "authoritative_commit_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "authoritative_revision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command_digest": {
          "$ref": "#/$defs/DigestValue"
        },
        "command_kind": {
          "$ref": "#/$defs/DomainReceiptCommandKind"
        },
        "condition_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "type": "string"
        },
        "draft_artifact_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "idempotency_key": {
          "type": "string"
        },
        "prior_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "producer_cause": {
          "$ref": "#/$defs/DomainReceiptProducerCause"
        },
        "project_scope": {
          "$ref": "#/$defs/ProjectScope"
        },
        "proposal_revision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "receipt_id": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/DomainReceiptResult"
        },
        "resulting_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "project_scope",
        "command_kind",
        "command_digest",
        "idempotency_key",
        "producer_cause",
        "author_command_admission_id",
        "expected_heads",
        "prior_heads",
        "resulting_heads",
        "authoritative_revision_ids",
        "proposal_revision_ids",
        "authoritative_commit_ids",
        "author_action_sequence",
        "draft_artifact_refs",
        "artifact_lifecycle_event_refs",
        "condition_refs",
        "result",
        "created_at"
      ],
      "type": "object"
    },
    "DomainReceiptCommandKind": {
      "enum": [
        "applyAuthorEdit",
        "takeOverProjectWriter",
        "createProject",
        "updateProject",
        "archiveProject",
        "createVolume",
        "createChapter",
        "updateVolume",
        "updateChapter",
        "deleteChapter",
        "deleteVolume",
        "setCurrentChapter",
        "undoLatestAuthorAction",
        "exportHumanReadableManuscript"
      ],
      "type": "string"
    },
    "DomainReceiptProducerCause": {
      "enum": [
        "author_command_admission"
      ],
      "type": "string"
    },
    "DomainReceiptResult": {
      "enum": [
        "authoritative_applied",
        "no_effect",
        "conflicted",
        "refused"
      ],
      "type": "string"
    },
    "EditorReadOnlyReason": {
      "enum": [
        "secondary_session",
        "superseded_by_takeover",
        "binding_invalid"
      ],
      "type": "string"
    },
    "EditorWriterProjection": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "current_writer",
              "type": "string"
            },
            "writer_generation": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "writer_generation"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "read_only",
              "type": "string"
            },
            "observed_writer_generation": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/EditorReadOnlyReason"
            }
          },
          "required": [
            "kind",
            "observed_writer_generation",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    },
    "TakeOverProjectWriterResult": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "takeover_applied",
              "type": "string"
            },
            "prior_editor_session_id": {
              "type": "string"
            },
            "prior_writer_generation": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            },
            "resulting_editor_session_id": {
              "type": "string"
            },
            "resulting_heads": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "resulting_snapshot_activity_position": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            },
            "resulting_snapshot_id": {
              "type": "string"
            },
            "resulting_writer_generation": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "prior_editor_session_id",
            "prior_writer_generation",
            "resulting_editor_session_id",
            "resulting_writer_generation",
            "resulting_snapshot_id",
            "resulting_snapshot_activity_position",
            "resulting_heads"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "current_heads": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "current_snapshot_activity_position": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            },
            "current_snapshot_id": {
              "type": "string"
            },
            "current_writer_generation": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            },
            "current_writer_projection": {
              "$ref": "#/$defs/EditorWriterProjection"
            },
            "kind": {
              "const": "takeover_compare_failed",
              "type": "string"
            },
            "observed_writer_generation": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/TakeoverCompareFailedReason"
            }
          },
          "required": [
            "kind",
            "observed_writer_generation",
            "current_writer_generation",
            "current_writer_projection",
            "current_snapshot_id",
            "current_snapshot_activity_position",
            "current_heads",
            "reason"
          ],
          "type": "object"
        }
      ]
