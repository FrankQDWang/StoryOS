{
  "$defs": {
    "CanonicalSnapshotMaps": {
      "additionalProperties": false,
      "description": "Closed empty maps for Stage 1 `canonical` SnapshotDescriptor watermarks.",
      "type": "object"
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    },
    "SnapshotDescriptor": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "project_activity_position": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        },
        "project_scope": {
          "$ref": "#/$defs/ProjectScope"
        },
        "projection_generations": {
          "$ref": "#/$defs/CanonicalSnapshotMaps"
        },
        "redaction_profile": {
          "type": "string"
        },
        "replay_generation": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        },
        "schema_profile": {
          "type": "string"
        },
        "snapshot_id": {
          "type": "string"
        },
        "snapshot_kind": {
          "$ref": "#/$defs/SnapshotKind"
        },
        "source_watermarks": {
          "$ref": "#/$defs/CanonicalSnapshotMaps"
        }
      },
      "required": [
        "snapshot_id",
        "project_scope",
        "snapshot_kind",
        "project_activity_position",
        "source_watermarks",
        "projection_generations",
        "redaction_profile",
        "schema_profile",
        "replay_generation",
        "created_at"
      ],
      "type": "object"
    },
    "SnapshotKind": {
      "description": "Closed `snapshot_kind` selected by the protocol SnapshotDescriptor.",
      "enum": [
        "canonical"
      ],
      "type": "string"
    }
  },
  "$id": "storyos.query.snapshot.response.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "type": "string"
    },
    "project_scope": {
      "$ref": "#/$defs/ProjectScope"
    },
    "schema_id": {
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/SnapshotDescriptor"
    }
  },
  "required": [
    "schema_id",
    "correlation_id",
    "project_scope",
    "snapshot"
  ],
  "title": "StoryOS Snapshot Response",
  "type": "object"
}
