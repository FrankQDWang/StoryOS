{
  "$defs": {
    "CanonicalSnapshotMaps": {
      "additionalProperties": false,
      "description": "Closed empty maps for Stage 1 `canonical` SnapshotDescriptor watermarks.",
      "type": "object"
    },
    "ControlledProject": {
      "additionalProperties": false,
      "properties": {
        "open": {
          "$ref": "#/$defs/ProjectOpenState"
        },
        "project_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "title",
        "open"
      ],
      "type": "object"
    },
    "ExportAcknowledgement": {
      "enum": [
        "accepted"
      ],
      "type": "string"
    },
    "ExportHumanReadableManuscriptEffect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "export_id": {
              "type": "string"
            },
            "export_profile": {
              "type": "string"
            },
            "kind": {
              "const": "admitted",
              "type": "string"
            },
            "source_snapshot": {
              "$ref": "#/$defs/SnapshotDescriptor"
            }
          },
          "required": [
            "kind",
            "export_id",
            "export_profile",
            "source_snapshot"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "refused",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/ExportHumanReadableManuscriptRefusalReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ExportHumanReadableManuscriptRefusalReason": {
      "enum": [
        "archived_project"
      ],
      "type": "string"
    },
    "HumanReadableManuscriptExportRef": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "export_id": {
              "type": "string"
            },
            "kind": {
              "const": "human_readable_manuscript_export",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "export_id"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectOpenState": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "current_chapter_id": {
              "type": "string"
            },
            "kind": {
              "const": "current_chapter",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "current_chapter_id"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    },
    "SnapshotDescriptor": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "type": "string"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_activity_position": {
          "type": "string"
        },
        "project_scope": {
          "$ref": "#/$defs/ProjectScope"
        },
        "projection_generations": {
          "$ref": "#/$defs/CanonicalSnapshotMaps"
        },
        "redaction_profile": {
          "type": "string"
        },
        "replay_generation": {
          "type": "string"
        },
        "schema_profile": {
          "type": "string"
        },
        "snapshot_id": {
          "type": "string"
        },
        "snapshot_kind": {
          "$ref": "#/$defs/SnapshotKind"
        },
        "source_watermarks": {
          "$ref": "#/$defs/CanonicalSnapshotMaps"
        }
      },
      "required": [
        "snapshot_id",
        "project_scope",
        "snapshot_kind",
        "project_activity_position",
        "source_watermarks",
        "projection_generations",
        "redaction_profile",
        "schema_profile",
        "replay_generation",
        "created_at"
      ],
      "type": "object"
    },
    "SnapshotKind": {
      "description": "Closed `snapshot_kind` selected by the protocol SnapshotDescriptor.",
      "enum": [
        "canonical"
      ],
      "type": "string"
    }
  },
  "$id": "storyos.command.export-human-readable-manuscript.response.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acknowledgement": {
      "$ref": "#/$defs/ExportAcknowledgement"
    },
    "author_command_admission_id": {
      "format": "uuid",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "type": "string"
    },
    "effect": {
      "$ref": "#/$defs/ExportHumanReadableManuscriptEffect"
    },
    "operation_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/HumanReadableManuscriptExportRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "project": {
      "$ref": "#/$defs/ControlledProject"
    },
    "project_scope": {
      "$ref": "#/$defs/ProjectScope"
    },
    "schema_id": {
      "const": "storyos.command.export-human-readable-manuscript.response.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "correlation_id",
    "project_scope",
    "command_id",
    "author_command_admission_id",
    "acknowledgement",
    "project",
    "effect"
  ],
  "title": "StoryOS Export Human-Readable Manuscript Response",
  "type": "object"
}
