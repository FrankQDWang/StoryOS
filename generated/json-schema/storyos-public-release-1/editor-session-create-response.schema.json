{
  "$defs": {
    "AuthoritativeChapterRevision": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        }
      },
      "required": [
        "revision_id",
        "body"
      ],
      "type": "object"
    },
    "DigestAlgorithm": {
      "enum": [
        "sha256"
      ],
      "type": "string"
    },
    "DigestValue": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/DigestAlgorithm"
        },
        "profile": {
          "type": "string"
        },
        "value_hex_lowercase": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "profile",
        "value_hex_lowercase"
      ],
      "type": "object"
    },
    "EditorBaseSnapshot": {
      "additionalProperties": false,
      "properties": {
        "authoritative_head_revision_id": {
          "type": "string"
        },
        "chapter_id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "materialized_payload_digest": {
          "$ref": "#/$defs/DigestValue"
        },
        "materialized_revision": {
          "$ref": "#/$defs/AuthoritativeChapterRevision"
        },
        "observed_ownership_partition": {
          "type": "string"
        },
        "project_activity_position": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        },
        "proposal_head_revision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "snapshot_id": {
          "type": "string"
        },
        "target_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "snapshot_id",
        "chapter_id",
        "project_activity_position",
        "authoritative_head_revision_id",
        "proposal_head_revision_ids",
        "target_refs",
        "observed_ownership_partition",
        "materialized_revision",
        "materialized_payload_digest",
        "created_at"
      ],
      "type": "object"
    },
    "EditorReadOnlyReason": {
      "enum": [
        "secondary_session"
      ],
      "type": "string"
    },
    "EditorSessionBinding": {
      "additionalProperties": false,
      "properties": {
        "client_contract_revision": {
          "type": "string"
        },
        "client_session_binding_ref": {
          "type": "string"
        },
        "client_session_generation": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        },
        "disposition": {
          "type": "string"
        },
        "editor_session_id": {
          "type": "string"
        },
        "opened_at": {
          "type": "string"
        },
        "security_policy_revision": {
          "type": "string"
        }
      },
      "required": [
        "editor_session_id",
        "client_session_binding_ref",
        "client_session_generation",
        "client_contract_revision",
        "security_policy_revision",
        "opened_at",
        "disposition"
      ],
      "type": "object"
    },
    "EditorWriterProjection": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "current_writer",
              "type": "string"
            },
            "writer_generation": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "writer_generation"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "read_only",
              "type": "string"
            },
            "observed_writer_generation": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/EditorReadOnlyReason"
            }
          },
          "required": [
            "kind",
            "observed_writer_generation",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "type": "string"
        },
        "project_id": {
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    }
  },
  "$id": "storyos.command.create-editor-session.response.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_snapshot": {
      "$ref": "#/$defs/EditorBaseSnapshot"
    },
    "correlation_id": {
      "type": "string"
    },
    "editor_session": {
      "$ref": "#/$defs/EditorSessionBinding"
    },
    "project_scope": {
      "$ref": "#/$defs/ProjectScope"
    },
    "schema_id": {
      "type": "string"
    },
    "writer": {
      "$ref": "#/$defs/EditorWriterProjection"
    }
  },
  "required": [
    "schema_id",
    "correlation_id",
    "project_scope",
    "editor_session",
    "writer",
    "base_snapshot"
  ],
  "title": "StoryOS Create Editor Session Response",
  "type": "object"
}
