{
  "$defs": {
    "AcceptanceRefusalBoundary": {
      "enum": [
        "challenge",
        "writer_session"
      ],
      "type": "string"
    },
    "AcceptanceRefusalReason": {
      "enum": [
        "stale_writer",
        "session_changed",
        "invalid_challenge"
      ],
      "type": "string"
    },
    "AuthorEditPrimitive": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "replace_structured_selection",
              "type": "string"
            },
            "replacement": {
              "items": {
                "$ref": "#/$defs/ReplacementBlock"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "replacement"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "replace_selection",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "to": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "from",
            "to",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "replace_block_selection",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "to": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "manuscript_block_id",
            "from",
            "to",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "split_block",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            },
            "new_manuscript_block_id": {
              "type": "string"
            },
            "offset": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "manuscript_block_id",
            "offset",
            "new_manuscript_block_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "join_blocks",
              "type": "string"
            },
            "left_manuscript_block_id": {
              "type": "string"
            },
            "right_manuscript_block_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "left_manuscript_block_id",
            "right_manuscript_block_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "move_block",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            },
            "to_index": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "manuscript_block_id",
            "to_index"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "block_kind": {
              "$ref": "#/$defs/ManuscriptBlockKind"
            },
            "kind": {
              "const": "retype_block",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "manuscript_block_id",
            "block_kind"
          ],
          "type": "object"
        }
      ]
    },
    "AuthorEditUnit": {
      "additionalProperties": false,
      "properties": {
        "normalized_primitives": {
          "items": {
            "$ref": "#/$defs/AuthorEditPrimitive"
          },
          "type": "array"
        },
        "selection_snapshot": {
          "$ref": "#/$defs/SelectionSnapshot"
        }
      },
      "required": [
        "normalized_primitives",
        "selection_snapshot"
      ],
      "type": "object"
    },
    "BlockProposalInspect": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "items": {
            "$ref": "#/$defs/ProposalAnchorInspect"
          },
          "type": "array"
        },
        "base_authoritative_revision_id": {
          "format": "uuid",
          "type": "string"
        },
        "candidate_blocks": {
          "items": {
            "$ref": "#/$defs/ReplacementBlock"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "candidate_text": {
          "type": "string"
        },
        "chapter_id": {
          "format": "uuid",
          "type": "string"
        },
        "closure": {
          "type": "string"
        },
        "condition_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "generation": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "block_edit",
            "inline_edit"
          ],
          "type": "string"
        },
        "latest_acceptance_refusal": {
          "$ref": "#/$defs/OptionalAcceptanceRefusalInspect"
        },
        "manuscript_block_id": {
          "format": "uuid",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "type": "string"
        },
        "operation_resolution": {
          "type": "string"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/ProposalOperationInspect"
          },
          "type": "array"
        },
        "proposal_id": {
          "format": "uuid",
          "type": "string"
        },
        "reservation_state": {
          "type": "string"
        },
        "revision_id": {
          "format": "uuid",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ProposalSourceInspect"
        },
        "source_condition": {
          "$ref": "#/$defs/ProposalSourceConditionInspect"
        },
        "validation": {
          "type": "string"
        },
        "validation_receipt": {
          "$ref": "#/$defs/OptionalValidationReceiptInspect"
        }
      },
      "required": [
        "proposal_id",
        "kind",
        "revision_id",
        "generation",
        "validation",
        "condition_refs",
        "source_condition",
        "latest_acceptance_refusal",
        "closure",
        "operation_id",
        "operation_resolution",
        "operations",
        "chapter_id",
        "manuscript_block_id",
        "base_authoritative_revision_id",
        "reservation_state",
        "candidate_text",
        "source",
        "validation_receipt",
        "anchors"
      ],
      "type": "object"
    },
    "EditSourceOwner": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "manuscript",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "manuscript_block_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "proposal",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            },
            "operation_id": {
              "type": "string"
            },
            "proposal_id": {
              "type": "string"
            },
            "revision_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "proposal_id",
            "operation_id",
            "revision_id",
            "manuscript_block_id"
          ],
          "type": "object"
        }
      ]
    },
    "ManuscriptBlockKind": {
      "enum": [
        "paragraph",
        "heading"
      ],
      "type": "string"
    },
    "OptionalAcceptanceRefusalInspect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "boundary": {
              "$ref": "#/$defs/AcceptanceRefusalBoundary"
            },
            "challenge_rate_policy_revision": {
              "type": "string"
            },
            "client_contract_revision": {
              "type": "string"
            },
            "command_schema": {
              "type": "string"
            },
            "correlation_id": {
              "type": "string"
            },
            "kind": {
              "const": "present",
              "type": "string"
            },
            "limit_profile_revision": {
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/AcceptanceRefusalReason"
            },
            "recorded_at": {
              "type": "string"
            },
            "refusal_id": {
              "type": "string"
            },
            "refusal_profile_revision": {
              "type": "string"
            },
            "security_policy_revision": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "refusal_id",
            "correlation_id",
            "reason",
            "boundary",
            "command_schema",
            "refusal_profile_revision",
            "client_contract_revision",
            "security_policy_revision",
            "limit_profile_revision",
            "challenge_rate_policy_revision",
            "recorded_at"
          ],
          "type": "object"
        }
      ]
    },
    "OptionalValidationReceiptInspect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "present",
              "type": "string"
            },
            "result": {
              "type": "string"
            },
            "validation_receipt_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "validation_receipt_id",
            "result"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "validation_receipt_id": {
          "format": "uuid"
        }
      }
    },
    "OrderedSourceSelection": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/SourceSelectionEndpoint"
        },
        "head": {
          "$ref": "#/$defs/SourceSelectionEndpoint"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SelectedEditSource"
          },
          "type": "array"
        }
      },
      "required": [
        "sources",
        "anchor",
        "head"
      ],
      "type": "object"
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    },
    "ProposalAnchorInspect": {
      "additionalProperties": false,
      "properties": {
        "base_authoritative_revision_id": {
          "format": "uuid",
          "type": "string"
        },
        "base_slice_digest": {
          "type": "string"
        },
        "boundary_profile": {
          "type": "string"
        },
        "coordinate_profile": {
          "type": "string"
        },
        "from": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "manuscript_block_id": {
          "format": "uuid",
          "type": "string"
        },
        "manuscript_schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "manuscript_block_id",
        "base_authoritative_revision_id",
        "manuscript_schema_version",
        "coordinate_profile",
        "from",
        "to",
        "boundary_profile",
        "base_slice_digest"
      ],
      "type": "object"
    },
    "ProposalOperationInspect": {
      "additionalProperties": false,
      "properties": {
        "candidate_blocks": {
          "items": {
            "$ref": "#/$defs/ReplacementBlock"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "manuscript_block_id": {
          "format": "uuid",
          "type": "string"
        },
        "operation_id": {
          "format": "uuid",
          "type": "string"
        },
        "reservation_state": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "manuscript_block_id",
        "resolution",
        "reservation_state"
      ],
      "type": "object"
    },
    "ProposalSourceConditionInspect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "absent",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "proposal_conflict",
              "type": "string"
            },
            "proposal_conflict_ref": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "proposal_conflict_ref"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "proposal_recovery_conflict",
              "type": "string"
            },
            "proposal_recovery_conflict_ref": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "proposal_recovery_conflict_ref"
          ],
          "type": "object"
        }
      ]
    },
    "ProposalSourceInspect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "decision_id": {
              "type": "string"
            },
            "kind": {
              "const": "agent_run_decision",
              "type": "string"
            },
            "run_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "run_id",
            "decision_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "draft_id": {
              "type": "string"
            },
            "draft_revision_id": {
              "type": "string"
            },
            "kind": {
              "const": "refused_edit_draft",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/RefusedEditPayload"
            },
            "payload_digest": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "draft_id",
            "draft_revision_id",
            "payload_digest",
            "payload"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "decision_id": {
          "format": "uuid"
        },
        "run_id": {
          "format": "uuid"
        }
      }
    },
    "RefusedEditPayload": {
      "additionalProperties": false,
      "properties": {
        "author_edit_units": {
          "items": {
            "$ref": "#/$defs/AuthorEditUnit"
          },
          "type": "array"
        },
        "chapter_id": {
          "type": "string"
        },
        "completed_intent_record_id": {
          "type": "string"
        },
        "expected_authoritative_revision_id": {
          "type": "string"
        },
        "expected_proposal_head_revision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "local_intent_sequence": {
          "type": "string"
        },
        "schema_revision": {
          "type": "string"
        },
        "target_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "undo_group_id": {
          "type": "string"
        }
      },
      "required": [
        "schema_revision",
        "chapter_id",
        "expected_authoritative_revision_id",
        "expected_proposal_head_revision_ids",
        "target_refs",
        "author_edit_units",
        "undo_group_id",
        "completed_intent_record_id",
        "local_intent_sequence"
      ],
      "type": "object"
    },
    "ReplacementBlock": {
      "additionalProperties": false,
      "properties": {
        "block_kind": {
          "$ref": "#/$defs/ManuscriptBlockKind"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "block_kind",
        "text"
      ],
      "type": "object"
    },
    "SelectedEditSource": {
      "additionalProperties": false,
      "properties": {
        "block_kind": {
          "$ref": "#/$defs/ManuscriptBlockKind"
        },
        "coordinate_profile": {
          "type": "string"
        },
        "from": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "owner": {
          "$ref": "#/$defs/EditSourceOwner"
        },
        "source_text": {
          "type": "string"
        },
        "to": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "owner",
        "coordinate_profile",
        "from",
        "to",
        "block_kind",
        "source_text"
      ],
      "type": "object"
    },
    "SelectionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "coordinate_profile": {
          "type": "string"
        },
        "from": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ordered_selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrderedSourceSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "coordinate_profile",
        "from",
        "to"
      ],
      "type": "object"
    },
    "SourceSelectionEndpoint": {
      "additionalProperties": false,
      "properties": {
        "source_index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_offset": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source_index",
        "source_offset"
      ],
      "type": "object"
    }
  },
  "$id": "storyos.query.proposal.response.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "type": "string"
    },
    "project_scope": {
      "$ref": "#/$defs/ProjectScope"
    },
    "proposal": {
      "$ref": "#/$defs/BlockProposalInspect"
    },
    "schema_id": {
      "const": "storyos.query.proposal.response.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "correlation_id",
    "project_scope",
    "proposal"
  ],
  "title": "StoryOS Proposal Response",
  "type": "object"
}
