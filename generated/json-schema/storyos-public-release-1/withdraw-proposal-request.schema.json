{
  "$defs": {
    "AgentRunDecisionKind": {
      "enum": [
        "agent_run_decision"
      ],
      "type": "string"
    },
    "AgentRunDecisionProducer": {
      "additionalProperties": false,
      "properties": {
        "decision_id": {
          "format": "uuid",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AgentRunDecisionKind"
        },
        "run_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "run_id",
        "decision_id"
      ],
      "type": "object"
    },
    "AuthorWithdrawalReason": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "author_withdrew",
              "type": "string"
            },
            "note": {
              "$ref": "#/$defs/BoundedAuthorNote"
            }
          },
          "required": [
            "kind",
            "note"
          ],
          "type": "object"
        }
      ]
    },
    "BoundedAuthorNote": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "omitted",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "present",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        }
      ]
    },
    "CurrentProducerWithdrawalReason": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "current_producer_withdrew",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "WithdrawProposalInput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "cause": {
              "const": "author",
              "type": "string"
            },
            "client_contract_revision": {
              "type": "string"
            },
            "correlation_id": {
              "format": "uuid",
              "type": "string"
            },
            "editor_session_id": {
              "format": "uuid",
              "type": "string"
            },
            "expected_closure": {
              "const": "open",
              "type": "string"
            },
            "expected_target_revisions": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "proposal_revision_id": {
              "format": "uuid",
              "type": "string"
            },
            "security_policy_revision": {
              "type": "string"
            },
            "withdrawal_reason": {
              "$ref": "#/$defs/AuthorWithdrawalReason"
            }
          },
          "required": [
            "cause",
            "proposal_revision_id",
            "expected_closure",
            "expected_target_revisions",
            "withdrawal_reason",
            "editor_session_id",
            "client_contract_revision",
            "security_policy_revision",
            "correlation_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "cause": {
              "const": "current_producer",
              "type": "string"
            },
            "client_contract_revision": {
              "type": "string"
            },
            "correlation_id": {
              "format": "uuid",
              "type": "string"
            },
            "expected_closure": {
              "const": "open",
              "type": "string"
            },
            "expected_target_revisions": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "producer": {
              "$ref": "#/$defs/AgentRunDecisionProducer"
            },
            "proposal_revision_id": {
              "format": "uuid",
              "type": "string"
            },
            "security_policy_revision": {
              "type": "string"
            },
            "withdrawal_reason": {
              "$ref": "#/$defs/CurrentProducerWithdrawalReason"
            }
          },
          "required": [
            "cause",
            "producer",
            "proposal_revision_id",
            "expected_closure",
            "expected_target_revisions",
            "withdrawal_reason",
            "client_contract_revision",
            "security_policy_revision",
            "correlation_id"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$id": "storyos.command.withdraw-proposal.request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command_schema": {
      "const": "storyos.command.withdraw-proposal.request.v1",
      "type": "string"
    },
    "withdraw_proposal_input": {
      "$ref": "#/$defs/WithdrawProposalInput"
    }
  },
  "required": [
    "command_schema",
    "withdraw_proposal_input"
  ],
  "title": "StoryOS Withdraw Proposal Request",
  "type": "object"
}
