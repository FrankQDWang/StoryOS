          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "to": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "coordinate_profile",
        "from",
        "to"
      ],
      "type": "object"
    }
