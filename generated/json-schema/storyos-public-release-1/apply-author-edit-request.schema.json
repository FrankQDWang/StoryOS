          "required": [
            "kind",
            "manuscript_block_id",
            "offset",
            "new_manuscript_block_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "join_blocks",
              "type": "string"
            },
            "left_manuscript_block_id": {
              "type": "string"
            },
