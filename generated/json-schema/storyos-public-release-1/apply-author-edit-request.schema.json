        "selection_snapshot": {
          "$ref": "#/$defs/SelectionSnapshot"
        }
      },
      "required": [
        "normalized_primitives",
        "selection_snapshot"
      ],
      "type": "object"
    },
    "SelectionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "coordinate_profile": {
          "type": "string"
