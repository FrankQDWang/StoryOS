{
  "$defs": {
    "AuthorEditPrimitive": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "replace_structured_selection",
              "type": "string"
            },
            "replacement": {
              "items": {
                "$ref": "#/$defs/ReplacementBlock"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "replacement"
          ],
          "type": "object"
        },
        {
          "properties": {
            "from": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "replace_selection",
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "to": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "from",
            "to",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "from": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "replace_block_selection",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "to": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "manuscript_block_id",
            "from",
            "to",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "split_block",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            },
            "new_manuscript_block_id": {
              "type": "string"
            },
            "offset": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "manuscript_block_id",
            "offset",
            "new_manuscript_block_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "join_blocks",
              "type": "string"
            },
            "left_manuscript_block_id": {
              "type": "string"
            },
            "right_manuscript_block_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "left_manuscript_block_id",
            "right_manuscript_block_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "move_block",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            },
            "to_index": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "manuscript_block_id",
            "to_index"
          ],
          "type": "object"
        },
        {
          "properties": {
            "block_kind": {
              "$ref": "#/$defs/ManuscriptBlockKind"
            },
            "kind": {
              "const": "retype_block",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "manuscript_block_id",
            "block_kind"
          ],
          "type": "object"
        }
      ]
    },
    "AuthorEditProposalTarget": {
      "additionalProperties": false,
      "description": "Binds an edit to one current Proposal, pending Operation, Revision, and Block.",
      "properties": {
        "manuscript_block_id": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "operation_id",
        "revision_id",
        "manuscript_block_id"
      ],
      "type": "object"
    },
    "AuthorEditUnit": {
      "additionalProperties": false,
      "properties": {
        "normalized_primitives": {
          "items": {
            "$ref": "#/$defs/AuthorEditPrimitive"
          },
          "type": "array"
        },
        "selection_snapshot": {
          "$ref": "#/$defs/SelectionSnapshot"
        }
      },
      "required": [
        "normalized_primitives",
        "selection_snapshot"
      ],
      "type": "object"
    },
    "EditSourceOwner": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "manuscript",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "manuscript_block_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "proposal",
              "type": "string"
            },
            "manuscript_block_id": {
              "type": "string"
            },
            "operation_id": {
              "type": "string"
            },
            "proposal_id": {
              "type": "string"
            },
            "revision_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "proposal_id",
            "operation_id",
            "revision_id",
            "manuscript_block_id"
          ],
          "type": "object"
        }
      ]
    },
    "ManuscriptBlockKind": {
      "enum": [
        "paragraph",
        "heading"
      ],
      "type": "string"
    },
    "OrderedSourceSelection": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/SourceSelectionEndpoint"
        },
        "head": {
          "$ref": "#/$defs/SourceSelectionEndpoint"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SelectedEditSource"
          },
          "type": "array"
        }
      },
      "required": [
        "sources",
        "anchor",
        "head"
      ],
      "type": "object"
    },
    "ReplacementBlock": {
      "additionalProperties": false,
      "properties": {
        "block_kind": {
          "$ref": "#/$defs/ManuscriptBlockKind"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "block_kind",
        "text"
      ],
      "type": "object"
    },
    "SelectedEditSource": {
      "additionalProperties": false,
      "properties": {
        "block_kind": {
          "$ref": "#/$defs/ManuscriptBlockKind"
        },
        "coordinate_profile": {
          "type": "string"
        },
        "from": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "owner": {
          "$ref": "#/$defs/EditSourceOwner"
        },
        "source_text": {
          "type": "string"
        },
        "to": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "owner",
        "coordinate_profile",
        "from",
        "to",
        "block_kind",
        "source_text"
      ],
      "type": "object"
    },
    "SelectionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "coordinate_profile": {
          "type": "string"
        },
        "from": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ordered_selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/OrderedSourceSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "coordinate_profile",
        "from",
        "to"
      ],
      "type": "object"
    },
    "SourceSelectionEndpoint": {
      "additionalProperties": false,
      "properties": {
        "source_index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source_offset": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source_index",
        "source_offset"
      ],
      "type": "object"
    }
  },
  "$id": "storyos.command.apply-author-edit.request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "author_edit_units": {
      "items": {
        "$ref": "#/$defs/AuthorEditUnit"
      },
      "type": "array"
    },
    "chapter_id": {
      "type": "string"
    },
    "client_contract_revision": {
      "type": "string"
    },
    "command_schema": {
      "type": "string"
    },
    "completed_intent_record_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "editor_contract_revision": {
      "type": "string"
    },
    "editor_session_id": {
      "type": "string"
    },
    "expected_authoritative_revision_id": {
      "type": "string"
    },
    "expected_proposal_head_revision_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "local_intent_sequence": {
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
      "type": "string"
    },
    "observed_ownership_partition": {
      "type": "string"
    },
    "proposal_target": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorEditProposalTarget"
        },
        {
          "type": "null"
        }
      ]
    },
    "security_policy_revision": {
      "type": "string"
    },
    "target_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "undo_group_id": {
      "type": "string"
    },
    "writer_generation": {
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
      "type": "string"
    }
  },
  "required": [
    "command_schema",
    "client_contract_revision",
    "security_policy_revision",
    "correlation_id",
    "editor_session_id",
    "writer_generation",
    "chapter_id",
    "expected_authoritative_revision_id",
    "expected_proposal_head_revision_ids",
    "target_refs",
    "observed_ownership_partition",
    "editor_contract_revision",
    "undo_group_id",
    "completed_intent_record_id",
    "local_intent_sequence",
    "author_edit_units"
  ],
  "title": "StoryOS Apply Author Edit Request",
  "type": "object"
}
