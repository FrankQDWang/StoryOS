          "required": [
            "kind",
            "from",
            "to",
            "text"
          ],
          "type": "object"
        },
        {
          "properties": {
            "from": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "replace_block_selection",
