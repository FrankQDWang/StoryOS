{
  "$defs": {
    "ManuscriptSearchSelection": {
      "enum": [
        "current_chapter",
        "manuscript"
      ],
      "type": "string"
    }
  },
  "$id": "storyos.query.manuscript-search.request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "query_text": {
      "minLength": 1,
      "type": "string",
      "x-storyos-max-utf8-bytes": 1048576
    },
    "required_watermark": {
      "anyOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_id": {
      "const": "storyos.query.manuscript-search.request.v1",
      "type": "string"
    },
    "selection": {
      "$ref": "#/$defs/ManuscriptSearchSelection"
    }
  },
  "required": [
    "schema_id",
    "selection",
    "query_text"
  ],
  "title": "StoryOS Manuscript Search Request",
  "type": "object"
}
