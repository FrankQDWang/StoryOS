{
  "$defs": {
    "ControlledProject": {
      "additionalProperties": false,
      "properties": {
        "open": {
          "$ref": "#/$defs/ProjectOpenState"
        },
        "project_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "title",
        "open"
      ],
      "type": "object"
    },
    "DigestAlgorithm": {
      "enum": [
        "sha256"
      ],
      "type": "string"
    },
    "DigestValue": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/DigestAlgorithm"
        },
        "profile": {
          "type": "string"
        },
        "value_hex_lowercase": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "profile",
        "value_hex_lowercase"
      ],
      "type": "object"
    },
    "DomainReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifact_lifecycle_event_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "author_action_sequence": {
          "type": "string"
        },
        "author_command_admission_id": {
          "type": "string"
        },
        "authoritative_commit_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "authoritative_revision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command_digest": {
          "$ref": "#/$defs/DigestValue"
        },
        "command_kind": {
          "$ref": "#/$defs/DomainReceiptCommandKind"
        },
        "condition_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "type": "string"
        },
        "draft_artifact_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "idempotency_key": {
          "type": "string"
        },
        "prior_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "producer_cause": {
          "$ref": "#/$defs/DomainReceiptProducerCause"
        },
        "project_scope": {
          "$ref": "#/$defs/ProjectScope"
        },
        "proposal_revision_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "receipt_id": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/DomainReceiptResult"
        },
        "resulting_heads": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "project_scope",
        "command_kind",
        "command_digest",
        "idempotency_key",
        "producer_cause",
        "author_command_admission_id",
        "expected_heads",
        "prior_heads",
        "resulting_heads",
        "authoritative_revision_ids",
        "proposal_revision_ids",
        "authoritative_commit_ids",
        "author_action_sequence",
        "draft_artifact_refs",
        "artifact_lifecycle_event_refs",
        "condition_refs",
        "result",
        "created_at"
      ],
      "type": "object"
    },
    "DomainReceiptCommandKind": {
      "enum": [
        "applyAuthorEdit",
        "takeOverProjectWriter",
        "createProject",
        "updateProject",
        "archiveProject",
        "createVolume",
        "createChapter",
        "updateVolume",
        "updateChapter",
        "deleteChapter",
        "deleteVolume",
        "setCurrentChapter",
        "undoLatestAuthorAction",
        "exportHumanReadableManuscript",
        "exportProjectArchive",
        "updateProjectAssistance",
        "createAgentRun"
      ],
      "type": "string"
    },
    "DomainReceiptProducerCause": {
      "enum": [
        "author_command_admission"
      ],
      "type": "string"
    },
    "DomainReceiptResult": {
      "enum": [
        "authoritative_applied",
        "no_effect",
        "conflicted",
        "refused"
      ],
      "type": "string"
    },
    "ProjectAssistanceAvailability": {
      "enum": [
        "available",
        "unavailable"
      ],
      "type": "string"
    },
    "ProjectAssistanceBinding": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/ProjectAssistanceAvailability"
        },
        "external_compatibility_decision": {
          "format": "uuid",
          "type": "string"
        },
        "model_registration_revision": {
          "format": "uuid",
          "type": "string"
        },
        "processing_destination_identity": {
          "format": "uuid",
          "type": "string"
        },
        "processing_destination_identity_evidence_revision": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        },
        "project_model_use_binding_revision": {
          "format": "uuid",
          "type": "string"
        },
        "revision": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{3}|1844674407370955[0-9]{2}|18446744073709551[0-5]|1844674407370955160|1844674407370955161[0-5])$",
          "type": "string"
        }
      },
      "required": [
        "availability",
        "revision",
        "model_registration_revision",
        "processing_destination_identity",
        "processing_destination_identity_evidence_revision",
        "project_model_use_binding_revision",
        "external_compatibility_decision"
      ],
      "type": "object"
    },
    "ProjectOpenState": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "empty",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "current_chapter_id": {
              "type": "string"
            },
            "kind": {
              "const": "current_chapter",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "current_chapter_id"
          ],
          "type": "object"
        }
      ]
    },
    "ProjectScope": {
      "additionalProperties": false,
      "properties": {
        "owner_user_id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "owner_user_id",
        "project_id"
      ],
      "type": "object"
    },
    "UpdateProjectAssistanceConflictReason": {
      "enum": [
        "stale_assistance_revision"
      ],
      "type": "string"
    },
    "UpdateProjectAssistanceEffect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "availability": {
              "$ref": "#/$defs/ProjectAssistanceAvailability"
            },
            "kind": {
              "const": "initialized",
              "type": "string"
            },
            "project_activity_position": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "availability",
            "revision",
            "project_activity_position"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "availability": {
              "$ref": "#/$defs/ProjectAssistanceAvailability"
            },
            "kind": {
              "const": "authoritative_applied",
              "type": "string"
            },
            "project_activity_position": {
              "type": "string"
            },
            "revision": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "availability",
            "revision",
            "project_activity_position"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "no_effect",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UpdateProjectAssistanceNoEffectReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "conflicted",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/UpdateProjectAssistanceConflictReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "UpdateProjectAssistanceNoEffectReason": {
      "enum": [
        "availability_unchanged"
      ],
      "type": "string"
    }
  },
  "$id": "storyos.command.update-project-assistance.response.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assistance": {
      "$ref": "#/$defs/ProjectAssistanceBinding"
    },
    "author_command_admission_id": {
      "format": "uuid",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "type": "string"
    },
    "effect": {
      "$ref": "#/$defs/UpdateProjectAssistanceEffect"
    },
    "project": {
      "$ref": "#/$defs/ControlledProject"
    },
    "project_scope": {
      "$ref": "#/$defs/ProjectScope"
    },
    "receipt": {
      "$ref": "#/$defs/DomainReceipt"
    },
    "schema_id": {
      "const": "storyos.command.update-project-assistance.response.v1",
      "type": "string"
    }
  },
  "required": [
    "schema_id",
    "correlation_id",
    "project_scope",
    "command_id",
    "author_command_admission_id",
    "receipt",
    "project",
    "assistance",
    "effect"
  ],
  "title": "StoryOS Update Project Assistance Response",
  "type": "object"
}
